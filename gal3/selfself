function append
{
#     echo append $1 to $2
    cat "$BUILD/$1.txt" >> "$BUILD/$2.txt"
}

function new
{
    echo "">"$BUILD/$1.txt"
}

function gal3
{
    # unique temp per output so parallel compiles cannot collide
    local TF="$2.tmp"
    echo "        gal3 $1 '-->' $2"
    rm -f "$TF"
    python ~/.gal3/gal_3.py "$1" "$TF" < /dev/null
    if [ -f "$TF" ]
    then
        mv "$TF" "$2"
        mv "$TF.elems" "$2.elems" 2> /dev/null
        # echo "gal3 success creating $2"
    else
        echo "gal3 failed creating $2"
        exit 1
    fi
}

