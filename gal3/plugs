# compile the plugin sources to their include-free .gal forms before
# anything includes them. plugins are bare statement lists (no module
# wrapper): they are spliced INTO module Compiler by the include statement.
# resolving their own includes here is what makes nested includes terminate.
# the Documentation dialect lives in the generalabstractlanguage.com repo;
# it must be compiled before the manifest that includes it.
SITE="$HOME/code/generalabstractlanguage.com"
if [ -f "$SITE/src/Documentation.txt" ]; then
    gal3 "$SITE/src/Documentation.txt" Documentation.gal
fi
if [ -f gal_compiler_plugins.txt ]; then
    gal3 gal_compiler_plugins.txt gal_compiler_plugins.gal
fi
if [ -f "$SITE/src/documentation_main.txt" ]; then
    cp "$SITE/src/documentation_main.txt" "$BUILD/documentation_main.txt"
fi

