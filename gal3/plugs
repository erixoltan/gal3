#!/bin/bash
# SPDX-License-Identifier: Apache-2.0

echo "building gal3 and plugins with gal33"

# Activate the shared uv-managed Python environment for the whole toolchain.
source "$(dirname "$(readlink -f "$0")")/../galenv" || exit 1

BUILD="${GAL_BUILD:-$GAL_HOME/gal3build}"
mkdir -p "$BUILD"
BIN="$HOME/.gal3"
mkdir -p "$BIN"
cp bin/Runtime.py "$BIN"/
cp bin/pdebug.py "$BIN"/
cp bin/zdebug.py "$BIN"/

function append
{
#     echo append $1 to $2
    cat "$BUILD/$1.txt" >> "$BUILD/$2.txt"
}

function add_include
{
    echo ''>>"$BUILD/$1.txt"
    echo 'comment "BEGIN include gal_compiler_plugins.txt";'>>"$BUILD/$1.txt"
    echo ''>>"$BUILD/$1.txt"
    echo 'include "gal_compiler_plugins";'>>"$BUILD/$1.txt"
    echo ''>>"$BUILD/$1.txt"
    echo 'comment "END include gal_compiler_plugins.txt";'>>"$BUILD/$1.txt"
    echo ''>>"$BUILD/$1.txt"
}

function new
{
    echo "">"$BUILD/$1.txt"
}

function gal3
{
    TF=/tmp/out.gal
    echo "        gal3 $1 '-->' $2"
    python ~/.gal3/gal_33.py "$1" "$TF"
    if [ -f "$TF" ]
    then
        mv "$TF" "$2"
        mv "$TF.elems" "$2.elems" 2> /dev/null
        # echo "gal3 success creating $2"
    else
        echo "gal3 failed creating $2"
        exit 1
    fi
}

function fallback3
{
    TF=/tmp/out.fb
    echo "        fallback3 $1 '-->' $2"
    python ~/.gal3/fallback_33.py "$1" "$TF"
    if [ -f "$TF" ]
    then
        mv "$TF" "$2"
        mv "$TF.elems" "$2.elems" 2> /dev/null
        # echo "fallback3 success creating $2"
    else
        echo "fallback3 failed creating $2"
        exit 1
    fi
}

