#!/bin/bash
# SPDX-License-Identifier: Apache-2.0
# Fast rebuild of just the galjava_33 artifact with the fixpoint binaries
# (gal_33.py / fallback_33.py / galpy_33.py). Valid ONLY while edits are
# confined to java_inference.txt / java_main.txt — enforced
# below: any drift in a shared source aborts with "run the full loop".
#
# Writes galjava_33.{txt,tx2,gal,atomic,py} in $BUILD (so jsself's staleness
# guard stays coherent) and installs galjava_33.py in ~/.gal3/.
#
# NOTE: galjava.py and galjava_3.py go stale during this loop — they are
# bootstrap-only; the full ./build && ./selfbuild && ./selfself
# re-establishes them at milestone boundaries.

source "$(dirname "$(readlink -f "$0")")/../galenv" || exit 1

SRC="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
BUILD="${GAL_BUILD:-$GAL_HOME/gal3build}"
BIN="$HOME/.gal3"
mkdir -p "$BUILD" "$BIN"

# Discipline guard: every non-Java source in the galjava stack must match the
# copy the last full loop consumed. If one drifted, the fixpoint binaries
# no longer correspond to the sources and this shortcut is invalid.
SHARED="compiler_base compiler_dialect attributes_inference structure_inference data_type_inference inheritance_inference llm_inference gal_base fallback_inference"
for f in $SHARED; do
    if ! cmp -s "$SRC/$f.txt" "$BUILD/$f.txt"; then
        echo "galjavabuild: shared source $f.txt differs from the last full loop."
        echo "run ./build && ./selfbuild && ./selfself first."
        exit 1
    fi
done

cp "$SRC/java_inference.txt" "$SRC/java_main.txt" "$BUILD"/ || exit 1

# Re-concatenate the galjava stack exactly as selfself does (new = one blank
# line, then appends; zero itself starts with a blank line).
echo "">"$BUILD/zero.txt"
cat "$BUILD/compiler_base.txt" "$BUILD/compiler_dialect.txt" \
    "$BUILD/attributes_inference.txt" "$BUILD/structure_inference.txt" \
    "$BUILD/data_type_inference.txt" "$BUILD/inheritance_inference.txt" "$BUILD/llm_inference.txt" >> "$BUILD/zero.txt"

echo "">"$BUILD/galjava_33.txt"
cat "$BUILD/zero.txt" "$BUILD/gal_base.txt" "$BUILD/fallback_inference.txt" \
    "$BUILD/java_inference.txt" "$BUILD/llm_inference.txt" \
    "$BUILD/java_main.txt" >> "$BUILD/galjava_33.txt"

echo "module Compiler {">"$BUILD/galjava_33.tx2"
cat "$BUILD/galjava_33.txt">>"$BUILD/galjava_33.tx2"
echo "}">>"$BUILD/galjava_33.tx2"

function run33
{
    # run33 <binary> <in> <out>: run a _33 fixpoint binary, require output.
    rm -f "$3"
    echo "        $1 $2 '-->' $3"
    python "$BIN/$1.py" "$2" "$3"
    if [ ! -f "$3" ]; then
        echo "galjavabuild: $1 did not create $3. aborting"
        exit 1
    fi
}

run33 gal_33 "$BUILD/galjava_33.tx2" "$BUILD/galjava_33.gal"

# fallback to fixpoint, same protocol as selfself's atomic()
FALLBACK="$BUILD/galjava_33.fallback"
cp "$BUILD/galjava_33.gal" "$FALLBACK"
rm -f "$BUILD"/galjava_33.fb* &> /dev/null
for (( COUNTER=0; COUNTER<5; COUNTER++)); do
    TEMP="$BUILD/galjava_33.fb$COUNTER"
    run33 fallback_33 "$FALLBACK" "$TEMP"
    if cmp -s "$FALLBACK" "$TEMP"; then
        echo "    files are equal!"
        break
    fi
    FALLBACK="$TEMP"
done
cp "$FALLBACK" "$BUILD/galjava_33.atomic"

run33 galpy_33 "$BUILD/galjava_33.atomic" "$BUILD/galjava_33.py"
# a generator bug can produce syntactically invalid python; fail loudly here
# rather than letting stale binaries pass downstream checks
python -m py_compile "$BUILD/galjava_33.py" || { echo "galjavabuild: galjava_33.py does not compile"; exit 1; }
cp "$BUILD/galjava_33.py" "$BIN/galjava_33.py"
echo "galjavabuild complete: $BIN/galjava_33.py"
