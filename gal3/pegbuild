#!/bin/bash
# SPDX-License-Identifier: Apache-2.0
# Fast rebuild of just the peg artifact (assumes ./build has run once so
# $BUILD/zero.txt exists). Mirrors the compile() steps in ./build.

source "$(dirname "$(readlink -f "$0")")/../galenv" || exit 1

BUILD="${GAL_BUILD:-$GAL_HOME/gal3build}"
BIN="$HOME/.gal3"

cp compiler_base.txt compiler_dialect.txt attributes_inference.txt structure_inference.txt data_type_inference.txt inheritance_inference.txt llm_inference.txt "$BUILD"/ || exit 1
echo "">"$BUILD/zero.txt"
cat "$BUILD/compiler_base.txt" "$BUILD/compiler_dialect.txt" "$BUILD/attributes_inference.txt" "$BUILD/structure_inference.txt" "$BUILD/data_type_inference.txt" "$BUILD/inheritance_inference.txt" "$BUILD/llm_inference.txt" >> "$BUILD/zero.txt"

cp peg_base.txt peg_gen.txt peg_main.txt "$BUILD"/ || exit 1

function gal2
{
    rm -f "$3"
    echo "        gal2 $2 '-->' $1 $3"
    python ~/.goalspell/goalspell gs $1 "$2" "$3"
    if [ ! -f "$3" ]
    then
        echo "did not create $3. aborting"
        exit 1
    fi
}

echo "">"$BUILD/peg.txt"
cat "$BUILD/zero.txt" >> "$BUILD/peg.txt"
cat "$BUILD/peg_base.txt" >> "$BUILD/peg.txt"
cat "$BUILD/peg_gen.txt" >> "$BUILD/peg.txt"
cat "$BUILD/peg_main.txt" >> "$BUILD/peg.txt"

echo "module Compiler {">"$BUILD/peg.tx2"
cat "$BUILD/peg.txt">>"$BUILD/peg.tx2"
echo "}">>"$BUILD/peg.tx2"
gal2 gs "$BUILD/peg.tx2" "$BUILD/peg.gal"

FALLBACK="$BUILD/peg.fallback"
cp "$BUILD/peg.gal" "$FALLBACK"
rm -f "$BUILD"/peg.fb* &> /dev/null
for (( COUNTER=0; COUNTER<5; COUNTER++)); do
    TEMP="$BUILD/peg.fb$COUNTER"
    gal2 fb "$FALLBACK" "$TEMP"
    if [ ! -f "$TEMP" ]; then
        echo "    no file $TEMP!"
        break
    fi
    if cmp -s "$FALLBACK" "$TEMP"; then
        echo "    files are equal!"
        break
    fi
    FALLBACK="$TEMP"
done
cp "$FALLBACK" "$BUILD/peg.atomic"

gal2 py "$BUILD/peg.atomic" "$BUILD/peg.py"
cp "$BUILD/peg.py" "$BIN/peg.py"
echo "peg build complete: $BIN/peg.py"
