# Generated build tree (per-artifact .txt/.gal/.atomic/.py, ~1.7 GB). The
# whole compiler is regenerated from source by ./bootstrap.sh; never commit it.
gal3build/
build/

# Shared uv-managed Python environment (recreated by `uv sync` / galenv).
# Commit pyproject.toml and uv.lock; never the venv itself.
.venv/

# JS/IDE dependencies (restored with `npm install` under gal3/web/ide).
node_modules/

# Generated element caches emitted alongside compiled artifacts.
*.elems

# Python build/cache cruft
__pycache__/
*.pyc

# Editor swap files (e.g. Kate)
.*.kate-swp

# Local scratch
*.tmp
